{
  "uid": "scrapal-fleet",
  "title": "Scrapal crawler fleet",
  "schemaVersion": 41,
  "refresh": "10s",
  "panels": [
    {"type":"stat","title":"Active runs","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"scrapal_crawl_active_runs","refId":"A"}]},
    {"type":"stat","title":"Pages / minute","gridPos":{"x":6,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(rate(scrapal_crawl_pages_total{stage=\"page\",outcome=\"completed\"}[5m])) * 60","refId":"A"}]},
    {"type":"timeseries","title":"Stage outcomes","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"sum by (stage,outcome) (rate(scrapal_crawl_pages_total[5m]))","legendFormat":"{{stage}} · {{outcome}}","refId":"A"}]},
    {"type":"timeseries","title":"Stage p95 latency","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,stage) (rate(scrapal_crawl_stage_duration_seconds_bucket[5m])))","legendFormat":"{{stage}}","refId":"A"}]}
  ]
}
